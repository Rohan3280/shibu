<?xml version="1.0" encoding="utf-8"?>
<!--
  No configure activity is declared: the widget picks up whatever the app is
  already set to. updatePeriodMillis is 0 because refreshes are driven by
  RotationEngine rather than by the system's own update period.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_card"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:previewLayout="@layout/widget_card"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0" />
